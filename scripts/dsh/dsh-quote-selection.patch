diff --git a/packages/client/ui-quote/tests/browser-plugin.client.spec.tsx b/packages/client/ui-quote/tests/browser-plugin.client.spec.tsx
new file mode 100644
index 0000000000..9d76d4ee70
--- /dev/null
+++ b/packages/client/ui-quote/tests/browser-plugin.client.spec.tsx
@@ -0,0 +1,139 @@
+// @vitest-environment jsdom
+/**
+ * ui-quote browser half on a real cordis Context with a real SlotRegistry:
+ * the plugin registers the quote entry at
+ * conversation.chat.assistant-actions and the dialog + per-paragraph
+ * tracker entries at conversation.input.overlay; one surface per Session
+ * backs every entry of that Session and two Sessions stay isolated;
+ * registration and surface disposal ride the plugin fiber. The node half
+ * stays inert.
+ */
+import { Context } from '@deepseek-ai/cordis'
+import { afterEach, describe, expect, it } from 'vitest'
+import { cleanup } from '@testing-library/react'
+import { SlotRegistry } from '@deepseek-ai/dsh-client-ui-renderer/client'
+import { LocaleRuntime } from '@deepseek-ai/dsh-client-locale/client'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { ParagraphTrackerInjected, QuoteActionInjected, QuoteDialogInjected } from '../src/client/slots.ts'
+import { apply, inject } from '../src/client/index.ts'
+import { apply as nodeApply } from '../src/index.ts'
+
+afterEach(cleanup)
+
+const sid = (key: string): SessionId => key as SessionId
+
+/** Boot the plugin over the real SlotRegistry and a real locale runtime. */
+async function bench() {
+  const ctx = new Context()
+  await ctx.plugin(SlotRegistry).await()
+  ctx.slots.register({
+    name: 'root',
+    children: {
+      'conversation.chat.assistant-actions': { kind: 'list', scope: 'session', owner: { messageId: 'm' } },
+      'conversation.input.overlay': { kind: 'list', scope: 'session' },
+    },
+  } as never, (() => null) as never)
+  ctx.provide('locale', new LocaleRuntime(ctx))
+  const fiber = ctx.plugin({ inject: [...inject], apply })
+  const overlay = () => ctx.slots.entries('conversation.input.overlay')
+  return {
+    ctx,
+    fiber,
+    actionEntry: () => {
+      const entry = ctx.slots.entries('conversation.chat.assistant-actions')[0]
+      if (entry === undefined) return undefined
+      return {
+        ...entry.options,
+        locale: entry.locale,
+        inject: entry.inject as unknown as ((sessionId: SessionId) => QuoteActionInjected) | undefined,
+      }
+    },
+    dialogEntry: () => {
+      const entry = overlay().find(candidate => candidate.options.id === 'quote-dialog')
+      if (entry === undefined) return undefined
+      return {
+        ...entry.options,
+        locale: entry.locale,
+        inject: entry.inject as unknown as ((sessionId: SessionId) => QuoteDialogInjected) | undefined,
+      }
+    },
+    trackerEntry: () => {
+      const entry = overlay().find(candidate => candidate.options.id === 'quote-paragraph')
+      if (entry === undefined) return undefined
+      return {
+        ...entry.options,
+        locale: entry.locale,
+        inject: entry.inject as unknown as ((sessionId: SessionId) => ParagraphTrackerInjected) | undefined,
+      }
+    },
+  }
+}
+
+describe('ui-quote browser plugin', () => {
+  it('registers the three entries with the documented ids, orders, and locale', async () => {
+    const b = await bench()
+    await b.fiber.await()
+    const action = b.actionEntry()
+    expect(action?.id).toBe('quote')
+    expect(action?.order).toBe(20)
+    expect(action?.locale).toBe('quote')
+    const dialog = b.dialogEntry()
+    expect(dialog?.id).toBe('quote-dialog')
+    expect(dialog?.order).toBe(3)
+    expect(dialog?.locale).toBe('quote')
+    const tracker = b.trackerEntry()
+    expect(tracker?.id).toBe('quote-paragraph')
+    expect(tracker?.order).toBe(4)
+    expect(tracker?.locale).toBe('quote')
+    const quote = b.ctx.locale.bind('quote')
+    expect(quote('dialog.title')).toBe('Quote message')
+    expect(quote('action.paragraph')).toBe('Quote this paragraph')
+  })
+
+  it('backs every entry of one Session with one shared surface, isolated per Session', async () => {
+    const b = await bench()
+    await b.fiber.await()
+    const first = b.actionEntry()?.inject?.(sid('s1'))
+    const firstDialog = b.dialogEntry()?.inject?.(sid('s1'))
+    const firstTracker = b.trackerEntry()?.inject?.(sid('s1'))
+    const second = b.actionEntry()?.inject?.(sid('s2'))
+    expect(first).toBeDefined()
+    expect(firstDialog).toBeDefined()
+    expect(firstTracker).toBeDefined()
+    expect(second).toBeDefined()
+    if (first === undefined || firstDialog === undefined || firstTracker === undefined) return
+    // Same Session: the dialog state the action opens is the one the overlay
+    // reads, and the paragraph tracker opens the same dialog.
+    first.open({ kind: 'assistant', messageId: undefined, turn: 1, step: 1, time: 1, text: 'hi', truncated: false })
+    expect(firstDialog.hooks.dialog.getSnapshot().open).toBe(true)
+    expect(first.hooks.dialog.getSnapshot().open).toBe(true)
+    first.open({ kind: 'assistant', messageId: undefined, turn: 2, step: 1, time: 2, text: 'para', truncated: false })
+    expect(firstDialog.hooks.dialog.getSnapshot().target?.text).toBe('para')
+    firstTracker.open({ kind: 'assistant', messageId: undefined, turn: 3, step: 1, time: 3, text: 'para quote', truncated: false })
+    expect(firstDialog.hooks.dialog.getSnapshot().target?.text).toBe('para quote')
+    // Other Session: untouched.
+    expect(second?.hooks.dialog.getSnapshot().open).toBe(false)
+    // The overlay edits and closes through its own verbs.
+    firstDialog.setComment('note')
+    expect(firstDialog.hooks.dialog.getSnapshot().comment).toBe('note')
+    firstDialog.close()
+    expect(first.hooks.dialog.getSnapshot().open).toBe(false)
+  })
+
+  it('registers the locale dictionaries on the fiber and retires the surfaces on dispose', async () => {
+    const b = await bench()
+    await b.fiber.await()
+    const surface = b.actionEntry()?.inject?.(sid('s1'))
+    surface?.open({ kind: 'assistant', messageId: undefined, turn: 1, step: 1, time: 1, text: 'hi', truncated: false })
+    expect(b.ctx.locale.bind('quote')('dialog.title')).toBe('Quote message')
+    await b.fiber.dispose()
+    expect(surface?.hooks.dialog.getSnapshot().open).toBe(false)
+    expect(b.ctx.slots.entries('conversation.chat.assistant-actions')).toHaveLength(0)
+  })
+
+  it('keeps the node half inert', () => {
+    expect(nodeApply).toBeTypeOf('function')
+    nodeApply()
+    expect(nodeApply()).toBeUndefined()
+  })
+})
diff --git a/packages/client/ui-quote/tests/paragraph.client.spec.tsx b/packages/client/ui-quote/tests/paragraph.client.spec.tsx
