@@ -0,0 +1,213 @@
+// @vitest-environment jsdom
+/**
+ * Paragraph quote tracker: the pure helpers (step anchors, text capping)
+ * and the hover behavior — a paragraph inside an assistant-step seat shows
+ * the margin box, a paragraph elsewhere or without text does not, and the
+ * click opens the dialog with the paragraph text and the step's anchors.
+ */
+import { cleanup, fireEvent, render, screen, act } from '@testing-library/react'
+import { makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import { en as commonEn } from '@deepseek-ai/dsh-client-locale/src/locales/en.ts'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import type { AssistantChatData, ChatSnapshot } from '@deepseek-ai/dsh-client-ui-chat/client'
+import { capParagraphText, ParagraphQuoteTracker, stepAnchorsOf } from '../src/client/paragraph.tsx'
+import type { ParagraphTrackerProps } from '../src/client/slots.ts'
+import { QUOTE_TEXT_CAP } from '../src/client/quote.ts'
+import { en } from '../src/client/locales.ts'
+
+afterEach(cleanup)
+
+const t = makeTranslate(en, commonEn)
+
+describe('stepAnchorsOf', () => {
+  it('resolves turn/step/time and the optional message id', () => {
+    const data = { turn: 5, step: 2, time: 1700000000000, finalNode: { messageId: 'm-9' } } as Partial<AssistantChatData>
+    expect(stepAnchorsOf(data)).toEqual({ turn: 5, step: 2, time: 1700000000000, messageId: 'm-9' })
+  })
+
+  it('falls back to the turn number when no step is recorded', () => {
+    const data: Partial<AssistantChatData> = { turn: 5, time: 1700000000000 }
+    expect(stepAnchorsOf(data)).toEqual({ turn: 5, step: 5, time: 1700000000000, messageId: undefined })
+  })
+
+  it('rejects payloads without turn or time', () => {
+    expect(stepAnchorsOf({ turn: 5 })).toBeUndefined()
+    expect(stepAnchorsOf({ time: 1700000000000 })).toBeUndefined()
+    expect(stepAnchorsOf(null)).toBeUndefined()
+    expect(stepAnchorsOf('assistant-step')).toBeUndefined()
+  })
+})
+
+describe('capParagraphText', () => {
+  it('trims and passes short paragraphs through', () => {
+    expect(capParagraphText('  hello  ')).toEqual({ text: 'hello', truncated: false })
+  })
+
+  it('caps long paragraphs at the shared quote cap', () => {
+    const text = 'x'.repeat(QUOTE_TEXT_CAP + 100)
+    const capped = capParagraphText(text)
+    expect(capped.truncated).toBe(true)
+    expect(capped.text.length).toBe(QUOTE_TEXT_CAP)
+  })
+})
+
+/** A chat snapshot exposing one assistant-step node under the given key. */
+const fakeChat = (key: string, data: unknown): ChatSnapshot => {
+  const map = new Map<string, { key: string; kind: string; data: unknown }>()
+  map.set(key, { key, kind: 'assistant-step', data })
+  return { nodes: map } as unknown as ChatSnapshot
+}
+
+interface BenchOptions {
+  data?: unknown
+  kind?: string
+  chatAbsent?: boolean
+}
+
+function bench(options: BenchOptions = {}) {
+  const open = vi.fn()
+  const data = options.data ?? { turn: 3, step: 1, time: 1700000000000, finalNode: { messageId: 'm-1' } }
+  const chat = options.chatAbsent ? undefined : fakeChat('k-step-1', data)
+  const useConversation = (selector: (state: { views: { get: (target: string) => unknown } }) => unknown) =>
+    selector({ views: { get: (target: string) => (target === 'chat' ? chat : undefined) } })
+  const props = { open, useConversation, t } as unknown as ParagraphTrackerProps
+  render(<ParagraphQuoteTracker {...props} />)
+  return { open }
+}
+
+/** Mount one seat wrapper with a paragraph, and stub its layout box. */
+function mountSeat({ key = 'k-step-1', kind = 'assistant-step', text = 'hello paragraph' }: { key?: string; kind?: string; text?: string } = {}) {
+  const fixture = document.createElement('div')
+  fixture.setAttribute('data-seat-fixture', '')
+  fixture.setAttribute('data-chat-anchor-key', key)
+  fixture.setAttribute('data-chat-flow-kind', kind)
+  fixture.innerHTML = `<p>${text}</p>`
+  document.body.appendChild(fixture)
+  const p = fixture.querySelector('p') as HTMLParagraphElement
+  const rect = { top: 120, left: 240, right: 900, bottom: 150, width: 660, height: 30, x: 240, y: 120, toJSON: () => rect }
+  vi.spyOn(p, 'getBoundingClientRect').mockReturnValue(rect as DOMRect)
+  return p
+}
+
+const box = () => document.querySelector('[data-dsw-quote-box]')
+
+beforeEach(() => {
+  vi.restoreAllMocks()
+})
+
+afterEach(() => {
+  for (const fixture of Array.from(document.querySelectorAll('[data-seat-fixture]'))) fixture.remove()
+})
+
+describe('ParagraphQuoteTracker', () => {
+  it('shows the margin box when a paragraph inside an assistant step is hovered', () => {
+    bench()
+    const p = mountSeat()
+    expect(box()).toBeNull()
+    fireEvent.mouseMove(p)
+    expect(box()).not.toBeNull()
+    expect(box()?.getAttribute('aria-label')).toBe(t('action.paragraph'))
+    // Hovering the same paragraph again is a no-op (same element, same rect).
+    const first = box()
+    fireEvent.mouseMove(p)
+    expect(box()).toBe(first)
+  })
+
+  it('clicking the box opens the dialog with the paragraph text and step anchors', () => {
+    const { open } = bench()
+    const p = mountSeat({ text: 'the exact sentence' })
+    fireEvent.mouseMove(p)
+    fireEvent.click(box() as Element)
+    expect(open).toHaveBeenCalledTimes(1)
+    expect(open).toHaveBeenCalledWith({
+      kind: 'assistant',
+      messageId: 'm-1',
+      turn: 3,
+      step: 1,
+      time: 1700000000000,
+      text: 'the exact sentence',
+      truncated: false,
+    })
+    expect(box()).toBeNull()
+  })
+
+  it('supports the still-streaming case: no blocks, no messageId, text as rendered', () => {
+    const { open } = bench({ data: { turn: 7, time: 1700000001234 } })
+    const p = mountSeat({ text: 'partial line being rendered' })
+    fireEvent.mouseMove(p)
+    fireEvent.click(box() as Element)
+    expect(open).toHaveBeenCalledWith(expect.objectContaining({
+      turn: 7,
+      step: 7,
+      time: 1700000001234,
+      messageId: undefined,
+      text: 'partial line being rendered',
+    }))
+  })
+
+  it('hides for paragraphs outside an assistant-step seat', () => {
+    bench()
+    const p = mountSeat({ kind: 'user', key: 'k-user-1' })
+    fireEvent.mouseMove(p)
+    expect(box()).toBeNull()
+  })
+
+  it('hides for paragraphs without text', () => {
+    bench()
+    const p = mountSeat({ text: '   ' })
+    fireEvent.mouseMove(p)
+    expect(box()).toBeNull()
+  })
+
+  it('lingers through the grace period after the pointer leaves, then hides', () => {
+    vi.useFakeTimers()
+    try {
+      bench()
+      const p = mountSeat()
+      fireEvent.mouseMove(p)
+      expect(box()).not.toBeNull()
+      const outside = document.createElement('div')
+      document.body.appendChild(outside)
+      fireEvent.mouseMove(outside)
+      // Within the grace window the box is still reachable.
+      expect(box()).not.toBeNull()
+      act(() => { vi.advanceTimersByTime(400) })
+      expect(box()).toBeNull()
+      outside.remove()
+    } finally {
+      vi.useRealTimers()
+    }
+  })
+
+  it('stays visible while the pointer rests on the box during the grace', () => {
+    vi.useFakeTimers()
+    try {
+      bench()
+      const p = mountSeat()
+      fireEvent.mouseMove(p)
+      const el = box()
+      expect(el).not.toBeNull()
+      if (el === null) return
+      // Pointer leaves the paragraph but lands on the box itself: no hide scheduled.
+      fireEvent.mouseMove(el)
+      act(() => { vi.advanceTimersByTime(1000) })
+      expect(box()).not.toBeNull()
+    } finally {
+      vi.useRealTimers()
+    }
+  })
+
+  it('hides when the step payload has no temporal anchors', () => {
+    bench({ data: { turn: 3 } })
+    const p = mountSeat()
+    fireEvent.mouseMove(p)
+    expect(box()).toBeNull()
+  })
+
+  it('does not render a box before any hover', () => {
+    bench()
+    mountSeat()
+    expect(box()).toBeNull()
+    expect(screen.queryByRole('button', { name: t('action.paragraph') })).toBeNull()
+  })
+})
diff --git a/packages/client/ui-quote/tests/quote-actions.client.spec.tsx b/packages/client/ui-quote/tests/quote-actions.client.spec.tsx
