@@ -0,0 +1,55 @@
+/**
+ * QuoteSurface: the per-session dialog state transitions shared by the
+ * action entry and the overlay entry.
+ */
+import { describe, expect, it } from 'vitest'
+import { QuoteSurface, QUOTE_CLOSED } from '../src/client/surface.ts'
+import { buildTarget } from '../src/client/quote.ts'
+
+const target = buildTarget([{ kind: 'text', text: 'hello' }], 'm-1', 3, 1, 1700000000000)
+
+describe('QuoteSurface', () => {
+  it('rests closed', () => {
+    const surface = new QuoteSurface()
+    expect(surface.state.getSnapshot()).toEqual(QUOTE_CLOSED)
+  })
+
+  it('opens with the target and an empty comment', () => {
+    const surface = new QuoteSurface()
+    surface.open(target)
+    expect(surface.state.getSnapshot()).toEqual({ open: true, target, comment: '' })
+  })
+
+  it('replaces an open target, resetting the comment', () => {
+    const surface = new QuoteSurface()
+    surface.open(target)
+    surface.setComment('old comment')
+    const other = buildTarget([{ kind: 'text', text: 'other' }], 'm-2', 4, 2, 1700000000001)
+    surface.open(other)
+    expect(surface.state.getSnapshot()).toEqual({ open: true, target: other, comment: '' })
+  })
+
+  it('edits the comment and closes cleanly', () => {
+    const surface = new QuoteSurface()
+    surface.open(target)
+    surface.setComment('this is right, i don\'t like this')
+    expect(surface.state.getSnapshot().comment).toBe('this is right, i don\'t like this')
+    surface.close()
+    expect(surface.state.getSnapshot()).toEqual(QUOTE_CLOSED)
+  })
+
+  it('ignores a comment write that keeps the value', () => {
+    const surface = new QuoteSurface()
+    surface.open(target)
+    const before = surface.state.getSnapshot()
+    surface.setComment('')
+    expect(surface.state.getSnapshot()).toBe(before)
+  })
+
+  it('disposes into the closed state', () => {
+    const surface = new QuoteSurface()
+    surface.open(target)
+    surface.dispose()
+    expect(surface.state.getSnapshot()).toEqual(QUOTE_CLOSED)
+  })
+})
