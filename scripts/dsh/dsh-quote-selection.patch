@@ -0,0 +1,84 @@
+/**
+ * The quote dialog entry: a centered body-portaled modal seated in the
+ * composer overlay. Shows the quoted text with its temporal header line,
+ * takes a comment, and either sends (quote + comment + existing draft) or
+ * stages the same composition into the composer for manual sending.
+ * @module @deepseek-ai/dsh-client-ui-quote/client/dialog
+ */
+
+import { useCallback } from 'react'
+import { Button, Modal } from '@deepseek-ai/dsh-client-ui-primitives'
+import { composeDraft, formatQuoteTime } from './quote.ts'
+import type { QuoteDialogProps } from './slots.ts'
+import css from './dialog.module.css'
+
+/**
+ * The quote dialog overlay entry.
+ * @param props - slot runtime + injected quote face + the Session standard kit.
+ * @returns the modal element, or null while closed.
+ */
+export function QuoteDialog({
+  useDialog, setComment, close, useInput, inputActions, t,
+}: QuoteDialogProps) {
+  const state = useDialog(snapshot => snapshot)
+  const draft = useInput(snapshot => snapshot.draft)
+  const target = state.open ? state.target : null
+  const comment = state.comment
+  const empty = target === null || target.text.length === 0
+
+  const header = target === null
+    ? undefined
+    : `assistant · turn ${target.turn} · step ${target.step} · ${formatQuoteTime(target.time)}`
+      + (target.messageId !== undefined ? ` · msg ${target.messageId}` : '')
+
+  const compose = useCallback(() => {
+    if (target === null) return ''
+    return composeDraft(target, comment, draft)
+  }, [target, comment, draft])
+
+  const onSend = useCallback(() => {
+    if (target === null || inputActions === undefined) return
+    inputActions.setDraft(compose())
+    inputActions.submit()
+    close()
+  }, [close, compose, inputActions, target])
+
+  const onStage = useCallback(() => {
+    if (target === null || inputActions === undefined) return
+    inputActions.setDraft(compose())
+    close()
+  }, [close, compose, inputActions, target])
+
+  return (
+    <Modal
+      open={state.open}
+      onClose={close}
+      title={t('dialog.title')}
+      closeLabel={t('dialog.close')}
+      {...(css.dialog !== undefined ? { className: css.dialog } : {})}
+      {...(header !== undefined ? { description: header } : {})}
+      footer={empty
+        ? <Button variant="outline" onClick={close}>{t('dialog.close')}</Button>
+        : (
+            <>
+              <Button variant="outline" onClick={onStage}>{t('dialog.stage')}</Button>
+              <Button variant="primary" onClick={onSend}>{t('dialog.send')}</Button>
+            </>
+          )}
+    >
+      {empty ? (
+        <p className={css.empty}>{t('dialog.empty')}</p>
+      ) : (
+        <>
+          <pre className={css.preview}>{target.text}{target.truncated ? t('dialog.truncated') : ''}</pre>
+          <textarea
+            className={css.comment}
+            value={comment}
+            onChange={event => setComment(event.target.value)}
+            placeholder={t('dialog.commentPlaceholder')}
+          />
+        </>
+      )}
+    </Modal>
+  )
+}
diff --git a/packages/client/ui-quote/src/client/index.ts b/packages/client/ui-quote/src/client/index.ts
new file mode 100644
index 0000000000..3fbc06296e
--- /dev/null
+++ b/packages/client/ui-quote/src/client/index.ts
@@ -0,0 +1,103 @@
+/**
+ * Quote surface plugin, browser half: the quote entry in the
+ * conversation.chat.assistant-actions strip, the per-paragraph quote
+ * tracker box in the composer overlay (present while a step is still
+ * rendering or thinking — the steering case), and the quote dialog in
+ * conversation.input.overlay. One QuoteSurface per Session backs all three
+ * entries: the entries resolve the quoted step or paragraph and open the
+ * dialog, the overlay entry renders it and composes the submission.
+ * @module @deepseek-ai/dsh-client-ui-quote/client
+ */
+
+import type { Context as ClientContext } from '@deepseek-ai/cordis'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+// Type-only: pulls the ui-conversation SlotMap merge (the assistant-actions
+// and overlay entries) and the SessionStandardProps merge.
+import type {} from '@deepseek-ai/dsh-client-ui-conversation/client'
+// Type-only: pulls the ui-chat SlotMap merge (the assistant-actions seat)
+// and the ChatSnapshot type the action entry reads.
+import type {} from '@deepseek-ai/dsh-client-ui-chat/client'
+// Type-only: pulls the SlotRegistry service merge (ctx.slots).
+import type {} from '@deepseek-ai/dsh-client-ui-renderer/client'
+// Type-only: pulls the locale plugin's Context merge (ctx.locale).
+import type {} from '@deepseek-ai/dsh-client-locale/client'
+import { QuoteActions } from './actions.tsx'
+import { QuoteDialog } from './dialog.tsx'
+import { ParagraphQuoteTracker } from './paragraph.tsx'
+import type { ParagraphTrackerInjected, QuoteActionInjected, QuoteDialogInjected } from './slots.ts'
+import { QuoteSurface } from './surface.ts'
+import { en, zh } from './locales.ts'
+
+/** Dictionary namespace owned by this plugin. */
+const NS = 'quote'
+
+/** Required services: the slot registry and the copy. */
+export const inject = ['slots', 'locale']
+
+/**
+ * Client plugin body: the per-message quote action and the Session's
+ * quote dialog.
+ * @param ctx - client root context.
+ */
+export function apply(ctx: ClientContext): void {
+  ctx.effect(() => ctx.locale.register(NS, { zh, en }), 'ui-quote: dictionaries')
+
+  const surfaces = new Map<SessionId, QuoteSurface>()
+  const surfaceFor = (sessionId: SessionId): QuoteSurface => {
+    let surface = surfaces.get(sessionId)
+    if (surface === undefined) {
+      surface = new QuoteSurface()
+      surfaces.set(sessionId, surface)
+    }
+    return surface
+  }
+  ctx.effect(() => () => {
+    for (const surface of surfaces.values()) surface.dispose()
+    surfaces.clear()
+  }, 'ui-quote: per-session surfaces')
+
+  ctx.slots.inject('conversation.chat.assistant-actions', () => ctx.slots.register({
+    name: 'conversation.chat.assistant-actions',
+    id: 'quote',
+    order: 20,
+    locale: NS,
+    inject: (sessionId): QuoteActionInjected => {
+      const surface = surfaceFor(sessionId)
+      return {
+        hooks: { dialog: surface.state },
+        open: target => { surface.open(target) },
+      }
+    },
+  }, QuoteActions))
+
+  ctx.slots.inject('conversation.input.overlay', () => ctx.slots.register({
+    name: 'conversation.input.overlay',
+    id: 'quote-dialog',
+    order: 3,
+    locale: NS,
+    inject: (sessionId): QuoteDialogInjected => {
+      const surface = surfaceFor(sessionId)
+      return {
+        hooks: { dialog: surface.state },
+        setComment: text => { surface.setComment(text) },
+        close: () => { surface.close() },
+      }
+    },
+  }, QuoteDialog))
+
+  // The per-paragraph tracker box: one overlay entry per Session that
+  // follows the hovered paragraph across every assistant step (including
+  // the streaming one) and opens the same shared dialog.
+  ctx.slots.inject('conversation.input.overlay', () => ctx.slots.register({
+    name: 'conversation.input.overlay',
+    id: 'quote-paragraph',
+    order: 4,
+    locale: NS,
+    inject: (sessionId): ParagraphTrackerInjected => {
+      const surface = surfaceFor(sessionId)
+      return {
+        open: target => { surface.open(target) },
+      }
+    },
+  }, ParagraphQuoteTracker))
+}
