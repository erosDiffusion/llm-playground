+/** `quote` namespace dictionaries. */
+
+/** Simplified Chinese dictionary (the key-set source of truth). */
+export const zh = {
+  'action.quote': '引用这条消息',
+  'action.paragraph': '引用这一段',
+  'dialog.title': '引用消息',
+  'dialog.close': '关闭',
+  'dialog.empty': '这条消息没有可引用的文本。',
+  'dialog.commentPlaceholder': '添加你的评论…',
+  'dialog.send': '发送',
+  'dialog.stage': '放入输入框',
+  'dialog.truncated': '…（已截断）',
+} satisfies Record<string, string>
+
+/** The quote namespace key union. */
+export type QuoteKey = keyof typeof zh
+
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface LocaleNamespaceMap {
+    /** The quote surface's copy: the message action and the dialog. */
+    quote: QuoteKey
+  }
+}
+
+/** English dictionary, checked complete against the zh key set. */
+export const en = {
+  'action.quote': 'Quote this message',
+  'action.paragraph': 'Quote this paragraph',
+  'dialog.title': 'Quote message',
+  'dialog.close': 'Close',
+  'dialog.empty': 'This message has no text to quote.',
+  'dialog.commentPlaceholder': 'Add your comment…',
+  'dialog.send': 'Send',
+  'dialog.stage': 'To composer',
+  'dialog.truncated': '…[truncated]',
+} satisfies Record<QuoteKey, string>
