diff --git a/packages/client/ui-quote/src/client/actions.tsx b/packages/client/ui-quote/src/client/actions.tsx
new file mode 100644
index 0000000000..f9978d677c
--- /dev/null
+++ b/packages/client/ui-quote/src/client/actions.tsx
@@ -0,0 +1,114 @@
+/**
+ * The quote action entry: one hover-revealed icon in the assistant message
+ * action strip. The seat owner carries the durable message id; the entry
+ * resolves the owning assistant step from the chat snapshot (turn, step,
+ * time, blocks) and opens the Session's quote dialog. Clicking is never
+ * gated on the composer state — quoting while the Session is busy is the
+ * steering case and submits through the queue like any other message.
+ * @module @deepseek-ai/dsh-client-ui-quote/client/actions
+ */
+
+import { useCallback } from 'react'
+import { Tooltip } from '@deepseek-ai/dsh-client-ui-primitives'
+import type {
+  AssistantBlock, AssistantChatData, ChatSnapshot,
+} from '@deepseek-ai/dsh-client-ui-chat/client'
+import { buildTarget } from './quote.ts'
+import type { QuoteActionProps } from './slots.ts'
+import css from './actions.module.css'
+
+/**
+ * The 16px quote glyph: two top corner brackets, outline style matching the
+ * strip's other icons.
+ * @returns the glyph element.
+ */
+export function QuoteGlyph() {
+  return (
+    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
+      <path
+        d="M5.8 2.5H3.4A1.9 1.9 0 0 0 1.5 4.4v2.1M10.2 2.5h2.4a1.9 1.9 0 0 1 1.9 1.9v2.1"
+        stroke="currentColor"
+        strokeWidth="1.5"
+        strokeLinecap="round"
+      />
+      <path
+        d="M5.8 13.5H3.4a1.9 1.9 0 0 1-1.9-1.9v-2.1M10.2 13.5h2.4a1.9 1.9 0 0 0 1.9-1.9v-2.1"
+        stroke="currentColor"
+        strokeWidth="1.5"
+        strokeLinecap="round"
+      />
+    </svg>
+  )
+}
+
+/** Assistant step data with a quotable text block, or nothing. */
+export function quotableData(data: unknown): { blocks: readonly AssistantBlock[]; messageId: string | undefined; turn: number; step: number; time: number } | undefined {
+  if (data === null || typeof data !== 'object') return undefined
+  const chat = data as Partial<AssistantChatData>
+  if (typeof chat.turn !== 'number' || typeof chat.time !== 'number') return undefined
+  const blocks = Array.isArray(chat.blocks) ? chat.blocks : undefined
+  if (blocks === undefined) return undefined
+  const text = blocks.some(block => block.kind === 'text' && block.text.length > 0)
+  if (!text) return undefined
+  const finalNode = chat.finalNode
+  return {
+    blocks,
+    messageId: finalNode !== undefined && typeof finalNode === 'object' && finalNode.messageId !== undefined
+      ? String(finalNode.messageId)
+      : undefined,
+    turn: chat.turn,
+    step: typeof chat.step === 'number' ? chat.step : Number(chat.turn),
+    time: chat.time,
+  }
+}
+
+/**
+ * Resolve the quotable assistant step for one finalized message id by
+ * scanning the snapshot nodes. The action strip renders in the turn-tail
+ * node, whose own payload is not the step data, so the step node must be
+ * found through its durable message id.
+ * @param chat - the Session's chat view snapshot.
+ * @param messageId - the seat owner's durable message id.
+ * @returns the step payload, or undefined when no step matches.
+ */
+export function resolveStepById(
+  chat: ChatSnapshot | undefined,
+  messageId: string | number | undefined,
+): ReturnType<typeof quotableData> {
+  if (chat === undefined || messageId === undefined) return undefined
+  for (const node of chat.nodes.values()) {
+    const data = quotableData(node.data)
+    if (data === undefined) continue
+    if (String(data.messageId ?? '') === String(messageId)) return data
+  }
+  return undefined
+}
+
+/**
+ * The assistant-message quote action entry.
+ * @param props - slot runtime + injected quote face + the Session standard kit.
+ * @returns the icon button element.
+ */
+export function QuoteActions({
+  open, messageId, useConversation, t,
+}: QuoteActionProps) {
+  const chat = useConversation(state => state.views.get('chat') as ChatSnapshot | undefined)
+  const onClick = useCallback(() => {
+    const data = resolveStepById(chat, messageId)
+    if (data === undefined) return
+    open(buildTarget(data.blocks, data.messageId, data.turn, data.step, data.time))
+  }, [chat, messageId, open])
+  const label = t('action.quote')
+  return (
+    <Tooltip label={label} side="bottom">
+      <button
+        type="button"
+        className={css.action}
+        aria-label={label}
+        onClick={onClick}
+      >
+        <QuoteGlyph />
+      </button>
+    </Tooltip>
+  )
+}
