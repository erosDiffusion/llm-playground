index 0000000000..52244d80e4
--- /dev/null
+++ b/packages/client/ui-quote/tests/quote-dialog.client.spec.tsx
@@ -0,0 +1,137 @@
+// @vitest-environment jsdom
+/**
+ * QuoteDialog rendering: closed until the surface opens it; the preview and
+ * the temporal header line; Send composes quote + comment + existing draft
+ * through setDraft + submit; To composer stages the same composition without
+ * submitting; typing routes through setComment and re-renders; the
+ * empty-text target shows the empty state with no send.
+ */
+import { useSyncExternalStore } from 'react'
+import { act, cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import { en as commonEn } from '@deepseek-ai/dsh-client-locale/src/locales/en.ts'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { buildTarget, composeDraft, type QuoteTarget } from '../src/client/quote.ts'
+import type { QuoteDialogProps } from '../src/client/slots.ts'
+import { QUOTE_CLOSED, type QuoteDialogState } from '../src/client/surface.ts'
+import { QuoteDialog } from '../src/client/dialog.tsx'
+import { en } from '../src/client/locales.ts'
+
+afterEach(cleanup)
+
+const t = makeTranslate(en, commonEn)
+
+const TARGET: QuoteTarget = buildTarget(
+  [{ kind: 'text', text: 'first line\nsecond line' }],
+  '8f3a2b',
+  12,
+  1,
+  1700000000000,
+)
+
+interface Bench {
+  setComment: ReturnType<typeof vi.fn>
+  close: ReturnType<typeof vi.fn>
+  setDraft: ReturnType<typeof vi.fn>
+  submit: ReturnType<typeof vi.fn>
+  setDialog: (state: QuoteDialogState) => void
+}
+
+/** One mutable dialog store behind a useSyncExternalStore-backed hook. */
+function bench(initial: QuoteDialogState = QUOTE_CLOSED, draft = ''): Bench {
+  let state = initial
+  const listeners = new Set<() => void>()
+  const notify = () => { for (const listener of [...listeners]) listener() }
+  const dialog = {
+    getSnapshot: () => state,
+    subscribe: (listener: () => void) => {
+      listeners.add(listener)
+      return () => { listeners.delete(listener) }
+    },
+  }
+  const useDialog = (selector: (next: QuoteDialogState) => unknown) =>
+    selector(useSyncExternalStore(dialog.subscribe, dialog.getSnapshot))
+  const setComment = vi.fn((text: string) => {
+    state = { ...state, comment: text }
+    notify()
+  })
+  const close = vi.fn(() => {
+    state = QUOTE_CLOSED
+    notify()
+  })
+  const setDraft = vi.fn()
+  const submit = vi.fn()
+  const useInput = (selector: (next: { phase: string; draft: string }) => unknown) =>
+    selector({ phase: 'plain', draft })
+  const props = {
+    useDialog,
+    setComment,
+    close,
+    useInput,
+    inputActions: { setDraft, submit },
+    t,
+  } as unknown as QuoteDialogProps
+  render(<QuoteDialog {...props} />)
+  return {
+    setComment,
+    close,
+    setDraft,
+    submit,
+    setDialog: (next: QuoteDialogState) => {
+      state = next
+      notify()
+    },
+  }
+}
+
+describe('QuoteDialog', () => {
+  it('renders nothing while closed', () => {
+    bench()
+    expect(screen.queryByRole('dialog')).toBeNull()
+  })
+
+  it('shows the quote preview and the temporal header when open', () => {
+    const { setDialog } = bench()
+    act(() => { setDialog({ open: true, target: TARGET, comment: '' }) })
+    const dialog = screen.getByRole('dialog')
+    const text = dialog.textContent ?? ''
+    expect(text).toContain('first line')
+    expect(text).toContain('second line')
+    expect(text).toContain('assistant · turn 12 · step 1')
+    expect(text).toContain('msg 8f3a2b')
+    expect(text).toContain(t('dialog.title'))
+  })
+
+  it('Send composes quote + comment + existing draft, submits, and closes', async () => {
+    const b = bench(QUOTE_CLOSED, 'my pending draft')
+    act(() => { b.setDialog({ open: true, target: TARGET, comment: '' }) })
+    fireEvent.change(screen.getByPlaceholderText(t('dialog.commentPlaceholder')), {
+      target: { value: 'this is right, i don\'t like this' },
+    })
+    expect(b.setComment).toHaveBeenLastCalledWith('this is right, i don\'t like this')
+    fireEvent.click(screen.getByRole('button', { name: t('dialog.send') }))
+    expect(b.setDraft).toHaveBeenCalledTimes(1)
+    expect(b.setDraft).toHaveBeenCalledWith(composeDraft(TARGET, 'this is right, i don\'t like this', 'my pending draft'))
+    expect(b.submit).toHaveBeenCalledTimes(1)
+    expect(b.close).toHaveBeenCalledTimes(1)
+  })
+
+  it('To composer stages the same composition without submitting', () => {
+    const b = bench(QUOTE_CLOSED, '')
+    act(() => { b.setDialog({ open: true, target: TARGET, comment: '' }) })
+    fireEvent.click(screen.getByRole('button', { name: t('dialog.stage') }))
+    expect(b.setDraft).toHaveBeenCalledTimes(1)
+    expect(b.setDraft).toHaveBeenCalledWith(composeDraft(TARGET, '', ''))
+    expect(b.submit).not.toHaveBeenCalled()
+    expect(b.close).toHaveBeenCalledTimes(1)
+  })
+
+  it('shows the empty state with no send button for a text-less target', () => {
+    const { setDialog } = bench()
+    act(() => { setDialog({ open: true, target: buildTarget([], undefined, 2, 1, 1700000000000), comment: '' }) })
+    expect(screen.getByRole('dialog').textContent).toContain(t('dialog.empty'))
+    expect(screen.queryByRole('button', { name: t('dialog.send') })).toBeNull()
+    // The modal's own close button and the footer close button share the label.
+    expect(screen.getAllByRole('button', { name: t('dialog.close') }).length).toBeGreaterThanOrEqual(1)
+  })
+})
