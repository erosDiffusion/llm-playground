diff --git a/packages/client/ui-quote/src/client/paragraph.tsx b/packages/client/ui-quote/src/client/paragraph.tsx
new file mode 100644
index 0000000000..c50708effb
--- /dev/null
+++ b/packages/client/ui-quote/src/client/paragraph.tsx
@@ -0,0 +1,222 @@
+/**
+ * The per-paragraph quote tracker: a small box in the left margin of the
+ * hovered paragraph inside any assistant step, including the step that is
+ * still rendering or thinking. It tracks the live DOM (the text as it is
+ * being rendered), resolves the step's temporal anchors from the chat
+ * snapshot, and opens the Session's quote dialog with that paragraph as
+ * the quoted text. Mounted once per Session in the composer overlay so the
+ * affordance exists while output is streaming — the steering case.
+ * @module @deepseek-ai/dsh-client-ui-quote/client/paragraph
+ */
+
+import { useEffect, useRef, useState } from 'react'
+import { createPortal } from 'react-dom'
+import type {
+  AssistantChatData, ChatSnapshot,
+} from '@deepseek-ai/dsh-client-ui-chat/client'
+import { QUOTE_TEXT_CAP } from './quote.ts'
+import { QuoteGlyph } from './actions.tsx'
+import type { ParagraphTrackerProps } from './slots.ts'
+import css from './paragraph.module.css'
+
+/** Block-level elements the margin box attaches to. */
+const PARAGRAPH_SELECTOR = 'p, li, blockquote, pre, h1, h2, h3, h4, h5, h6'
+
+/** The seat wrapper marking one assistant step in the chat flow. */
+const SEAT_SELECTOR = '[data-chat-anchor-key][data-chat-flow-kind="assistant-step"]'
+
+/** Left margin needed for the 28px box plus a small gap. */
+const BOX_LEFT_MARGIN = 34
+
+/** The box lingers this long after the pointer leaves the paragraph, so it
+    can still be reached across the left margin. */
+const HIDE_GRACE_MS = 350
+
+/** One hovered paragraph and its resolved step anchors. */
+interface HoverState {
+  el: Element
+  top: number
+  left: number
+  text: string
+  truncated: boolean
+  turn: number
+  step: number
+  time: number
+  messageId: string | undefined
+}
+
+/**
+ * Resolve the step payload fields from one seat node's live data. The
+ * tracker deliberately does not require finalized blocks: while the step
+ * is still streaming (or only thinking) the visible text is what the
+ * human points at, and turn/step/time are already recorded.
+ * @param data - the seat node's live payload.
+ * @returns turn/step/time/messageId, or undefined for non-quotable nodes.
+ */
+export function stepAnchorsOf(data: unknown): { turn: number; step: number; time: number; messageId: string | undefined } | undefined {
+  if (data === null || typeof data !== 'object') return undefined
+  const step = data as Partial<AssistantChatData>
+  if (typeof step.turn !== 'number' || typeof step.time !== 'number') return undefined
+  const finalNode = step.finalNode
+  const messageId = finalNode !== undefined && typeof finalNode === 'object' && finalNode.messageId !== undefined
+    ? String(finalNode.messageId)
+    : undefined
+  return {
+    turn: step.turn,
+    step: typeof step.step === 'number' ? step.step : Number(step.turn),
+    time: step.time,
+    messageId,
+  }
+}
+
+/** Cap one paragraph's text for quoting. */
+export function capParagraphText(text: string): { text: string; truncated: boolean } {
+  const trimmed = text.trim()
+  if (trimmed.length <= QUOTE_TEXT_CAP) return { text: trimmed, truncated: false }
+  return { text: trimmed.slice(0, QUOTE_TEXT_CAP), truncated: true }
+}
+
+/**
+ * The per-paragraph quote tracker overlay entry.
+ * @param props - slot runtime + injected quote face + the Session standard kit.
+ * @returns the portaled margin box, or null while nothing is hovered.
+ */
+export function ParagraphQuoteTracker({ open, useConversation, t }: ParagraphTrackerProps) {
+  const chat = useConversation(state => state.views.get('chat') as ChatSnapshot | undefined)
+  const chatRef = useRef(chat)
+  chatRef.current = chat
+  const [hover, setHover] = useState<HoverState | null>(null)
+  const hoverRef = useRef(hover)
+  hoverRef.current = hover
+
+  useEffect(() => {
+    let hideTimer: ReturnType<typeof setTimeout> | undefined
+    const clearTimer = () => {
+      if (hideTimer !== undefined) {
+        clearTimeout(hideTimer)
+        hideTimer = undefined
+      }
+    }
+    // The box lingers briefly after the pointer leaves the paragraph so it
+    // can be reached across the left margin: the pointer crosses non-
+    // paragraph territory between the text and the box.
+    const scheduleHide = () => {
+      clearTimer()
+      hideTimer = setTimeout(() => {
+        hideTimer = undefined
+        setHover(null)
+      }, HIDE_GRACE_MS)
+    }
+    const onMove = (event: MouseEvent) => {
+      const source = event.target
+      if (!(source instanceof Element)) return
+      // Over the box itself: keep it and cancel any pending hide.
+      if (source.closest('[data-dsw-quote-box]') !== null) {
+        clearTimer()
+        return
+      }
+      const paragraph = source.closest(PARAGRAPH_SELECTOR)
+      if (paragraph === null) {
+        scheduleHide()
+        return
+      }
+      const seat = paragraph.closest(SEAT_SELECTOR)
+      if (seat === null) {
+        scheduleHide()
+        return
+      }
+      const key = seat instanceof HTMLElement ? seat.dataset.chatAnchorKey : undefined
+      const snapshot = chatRef.current
+      if (key === undefined || snapshot === undefined) {
+        scheduleHide()
+        return
+      }
+      const node = snapshot.nodes.get(key)
+      const anchors = node === undefined ? undefined : stepAnchorsOf(node.data)
+      if (anchors === undefined) {
+        scheduleHide()
+        return
+      }
+      const capped = capParagraphText(paragraph.textContent ?? '')
+      if (capped.text.length === 0) {
+        scheduleHide()
+        return
+      }
+      const rect = paragraph.getBoundingClientRect()
+      const left = rect.left - BOX_LEFT_MARGIN
+      if (left < 4) {
+        scheduleHide()
+        return
+      }
+      const current = hoverRef.current
+      if (current !== null && current.el === paragraph
+        && Math.abs(current.top - rect.top) < 2) {
+        clearTimer()
+        return
+      }
+      clearTimer()
+      setHover({
+        el: paragraph,
+        top: Math.max(8, rect.top + 2),
+        left,
+        text: capped.text,
+        truncated: capped.truncated,
+        turn: anchors.turn,
+        step: anchors.step,
+        time: anchors.time,
+        messageId: anchors.messageId,
+      })
+    }
+    const onHide = () => {
+      clearTimer()
+      setHover(null)
+    }
+    document.addEventListener('mousemove', onMove)
+    document.addEventListener('scroll', onHide, true)
+    window.addEventListener('resize', onHide)
+    return () => {
+      clearTimer()
+      document.removeEventListener('mousemove', onMove)
+      document.removeEventListener('scroll', onHide, true)
+      window.removeEventListener('resize', onHide)
+    }
+  }, [])
+
+  const label = t('action.paragraph')
+  if (hover === null) return null
+  return createPortal(
+    <button
+      type="button"
+      data-dsw-quote-box=""
+      className={css.box}
+      style={{ top: hover.top, left: hover.left }}
+      aria-label={label}
+      title={label}
+      onClick={() => {
+        const current = hoverRef.current
+        if (current === null) return
+        // Re-read the text when the element survived streaming re-renders.
+        const capped = current.el.isConnected
+          ? capParagraphText(current.el.textContent ?? '')
+          : { text: current.text, truncated: current.truncated }
+        if (capped.text.length === 0) {
+          setHover(null)
+          return
+        }
+        open({
+          kind: 'assistant',
+          messageId: current.messageId,
+          turn: current.turn,
+          step: current.step,
+          time: current.time,
+          text: capped.text,
+          truncated: capped.truncated,
+        })
+        setHover(null)
+      }}
+    >
+      <QuoteGlyph />
+    </button>,
+    document.body,
+  )
+}
