index 0000000000..91ea655a39
--- /dev/null
+++ b/packages/client/ui-quote/src/client/quote.ts
@@ -0,0 +1,115 @@
+/**
+ * Pure quote logic: the target shape, text extraction, the composer draft
+ * block format, and the draft composition. No React, no services.
+ * @module @deepseek-ai/dsh-client-ui-quote/client/quote
+ */
+
+import type { AssistantBlock } from '@deepseek-ai/dsh-client-ui-conversation/client'
+
+/** Maximum quoted text length; longer steps are capped and marked. */
+export const QUOTE_TEXT_CAP = 4000
+
+/** Closing marker line of one quote block inside the composer draft. */
+export const QUOTE_MARKER_CLOSE = '[/quote]'
+
+/**
+ * One resolved quote target: the assistant step the human pointed at, the
+ * exact temporal anchors, and the quoted text (text blocks only — reasoning
+ * stays out by design).
+ */
+export interface QuoteTarget {
+  readonly kind: 'assistant'
+  /** Durable assistant message identity; absent on interrupted chunk fallbacks. */
+  readonly messageId: string | undefined
+  /** Conversation turn owning the step (the Nth human prompt). */
+  readonly turn: number
+  /** Step within the turn; undefined when the node carries no step boundary. */
+  readonly step: number | undefined
+  /** Unix epoch ms of the message's final timestamp. */
+  readonly time: number
+  /** The quoted text, capped at {@link QUOTE_TEXT_CAP}. */
+  readonly text: string
+  /** Whether the text was capped. */
+  readonly truncated: boolean
+}
+
+/** Join the quotable (text-only) blocks of one assistant step. */
+export function quoteTextOf(blocks: readonly AssistantBlock[]): string {
+  return blocks
+    .filter((block): block is Extract<AssistantBlock, { kind: 'text' }> => block.kind === 'text')
+    .map(block => block.text)
+    .join('\n\n')
+}
+
+/**
+ * Resolve one quote target from an assistant step's recorded payload.
+ * @param blocks - the step's content blocks.
+ * @param messageId - durable identity, when the step has a finalized message.
+ * @param turn - owning turn number.
+ * @param step - step within the turn, when recorded.
+ * @param time - final message timestamp in epoch ms.
+ * @returns the capped, ready-to-quote target.
+ */
+export function buildTarget(
+  blocks: readonly AssistantBlock[],
+  messageId: string | undefined,
+  turn: number,
+  step: number | undefined,
+  time: number,
+): QuoteTarget {
+  let text = quoteTextOf(blocks)
+  let truncated = false
+  if (text.length > QUOTE_TEXT_CAP) {
+    text = text.slice(0, QUOTE_TEXT_CAP)
+    truncated = true
+  }
+  return { kind: 'assistant', messageId, turn, step, time, text, truncated }
+}
+
+/** Local wall-clock ISO with offset and second precision, e.g. 2026-09-18T17:42:10+02:00. */
+export function formatQuoteTime(ms: number): string {
+  const d = new Date(ms)
+  const p = (n: number): string => String(n).padStart(2, '0')
+  const offsetMinutes = -d.getTimezoneOffset()
+  const sign = offsetMinutes >= 0 ? '+' : '-'
+  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`
+    + `T${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`
+    + `${sign}${p(Math.floor(Math.abs(offsetMinutes) / 60))}:${p(Math.abs(offsetMinutes) % 60)}`
+}
+
+/**
+ * Compose the quote block as it enters the composer draft: a marker header
+ * line with the temporal anchors, the quoted text as a markdown blockquote,
+ * and the closing marker. The header is self-describing for the model:
+ * turn/step identify the position in this conversation, the timestamp the
+ * wall-clock moment, the message id the durable record.
+ * @param target - the resolved quote target.
+ * @returns the block text, ready to prepend to the draft.
+ */
+export function buildQuoteBlock(target: QuoteTarget): string {
+  const meta = [
+    'assistant message',
+    `turn ${target.turn}`,
+    target.step !== undefined ? `step ${target.step}` : undefined,
+    target.truncated ? 'truncated' : undefined,
+  ].filter((part): part is string => part !== undefined).join(' · ')
+  const body = target.text.split('\n').map(line => `> ${line}`).join('\n')
+  const header = `[Quoted from: ${meta} · ${formatQuoteTime(target.time)}`
+    + (target.messageId !== undefined ? ` · msg ${target.messageId}` : '') + ']'
+  return `${header}\n${body}\n${QUOTE_MARKER_CLOSE}`
+}
+
+/**
+ * Compose the full draft for a quote submission or staging: the quote block,
+ * the dialog comment when present, then the composer's existing draft when
+ * non-empty. Everything is preserved; nothing is silently dropped.
+ * @param target - the resolved quote target.
+ * @param comment - the dialog comment, trimmed.
+ * @param existing - the composer's current draft.
+ * @returns the composed draft text.
+ */
+export function composeDraft(target: QuoteTarget, comment: string, existing: string): string {
+  return [buildQuoteBlock(target), comment.trim(), existing.trim()]
+    .filter(part => part !== '')
+    .join('\n\n')
+}
