@@ -0,0 +1,100 @@
+// @vitest-environment jsdom
+/**
+ * QuoteActions rendering: the icon opens the dialog with the step resolved
+ * from the seat owner's messageId (scanning the chat nodes for the matching
+ * assistant step), and stays inert when no step matches, the step has no
+ * text, or the chat snapshot is absent. Quoting is never gated on the
+ * composer state — clicking while the Session is busy is the steering case.
+ */
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import { en as commonEn } from '@deepseek-ai/dsh-client-locale/src/locales/en.ts'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import type { AssistantChatData, ChatSnapshot } from '@deepseek-ai/dsh-client-ui-chat/client'
+import { QuoteActions } from '../src/client/actions.tsx'
+import type { QuoteActionProps } from '../src/client/slots.ts'
+import { en } from '../src/client/locales.ts'
+
+afterEach(cleanup)
+
+const t = makeTranslate(en, commonEn)
+
+const assistantData = (overrides: Partial<AssistantChatData> = {}): AssistantChatData => ({
+  status: 'closed',
+  turn: 12,
+  step: 1,
+  blocks: [{ kind: 'text', text: 'the quoted line' }],
+  time: 1700000000000,
+  finalNode: { messageId: 'm-42' },
+  ...overrides,
+} as AssistantChatData)
+
+/** A chat snapshot whose nodes Map the owner-messageId scan can iterate. */
+const fakeChat = (step: AssistantChatData, extra: unknown[] = []): ChatSnapshot => {
+  const map = new Map<string, { key: string; kind: string; data: unknown }>()
+  map.set('k-step-1', { key: 'k-step-1', kind: 'assistant-step', data: step })
+  for (const [i, data] of extra.entries()) map.set(`k-x-${i}`, { key: `k-x-${i}`, kind: 'turn-tail', data })
+  return { nodes: map } as unknown as ChatSnapshot
+}
+
+function bench(options: { data?: unknown; chatAbsent?: boolean; messageId?: string | number } = {}) {
+  const open = vi.fn()
+  const data = options.data ?? assistantData()
+  const chat = options.chatAbsent ? undefined : fakeChat(data as AssistantChatData)
+  const useConversation = (selector: (state: { views: { get: (target: string) => unknown } }) => unknown) =>
+    selector({ views: { get: (target: string) => (target === 'chat' ? chat : undefined) } })
+  const props = {
+    open,
+    messageId: options.messageId ?? 'm-42',
+    useConversation,
+    t,
+  } as unknown as QuoteActionProps
+  render(<QuoteActions {...props} />)
+  return { open }
+}
+
+const button = () => screen.getByRole('button', { name: t('action.quote') })
+
+describe('QuoteActions', () => {
+  it('opens the dialog with the step resolved by owner messageId', () => {
+    const { open } = bench()
+    fireEvent.click(button())
+    expect(open).toHaveBeenCalledTimes(1)
+    expect(open).toHaveBeenCalledWith({
+      kind: 'assistant',
+      messageId: 'm-42',
+      turn: 12,
+      step: 1,
+      time: 1700000000000,
+      text: 'the quoted line',
+      truncated: false,
+    })
+  })
+
+  it('still opens while the Session is busy (the steering case)', () => {
+    // No composer gate exists: the entry resolves purely from the snapshot.
+    const { open } = bench()
+    expect(button().hasAttribute('data-unavailable')).toBe(false)
+    expect(button().hasAttribute('aria-disabled')).toBe(false)
+    fireEvent.click(button())
+    expect(open).toHaveBeenCalledTimes(1)
+  })
+
+  it('stays inert when no step carries the owner messageId', () => {
+    const { open } = bench({ messageId: 'm-missing' })
+    fireEvent.click(button())
+    expect(open).not.toHaveBeenCalled()
+  })
+
+  it('stays inert when the step has no text', () => {
+    const { open } = bench({ data: assistantData({ blocks: [{ kind: 'reasoning', text: 'thinking' }] }) })
+    fireEvent.click(button())
+    expect(open).not.toHaveBeenCalled()
+  })
+
+  it('stays inert when the chat snapshot is absent', () => {
+    const { open } = bench({ chatAbsent: true })
+    fireEvent.click(button())
+    expect(open).not.toHaveBeenCalled()
+  })
+})
diff --git a/packages/client/ui-quote/tests/quote-dialog.client.spec.tsx b/packages/client/ui-quote/tests/quote-dialog.client.spec.tsx
