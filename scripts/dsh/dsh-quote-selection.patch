+/**
+ * The injected faces of this package's two entries. The
+ * 'conversation.chat.assistant-actions' and 'conversation.input.overlay'
+ * slots are declared and typed by ui-chat and ui-conversation; this package
+ * only contributes entries. Live state arrives through the `hooks`
+ * compartment (the framework standard kit binds `dialog` into `useDialog`).
+ * @module @deepseek-ai/dsh-client-ui-quote/client/slots
+ */
+
+import type {
+  HostObservable, InjectFace, PropsLocale, PropsRuntime,
+} from '@deepseek-ai/dsh-client-ui-slots'
+// Type-only: pulls the ui-conversation SlotMap merge (the two slot names),
+// its standard-props merge (useInput/inputActions/useConversation), and the
+// AssistantBlock type this package quotes.
+import type {} from '@deepseek-ai/dsh-client-ui-conversation/client'
+// Type-only: pulls this package's LocaleNamespaceMap merge (the 'quote' seat).
+import type {} from './locales.ts'
+import type { QuoteTarget } from './quote.ts'
+import type { QuoteDialogState } from './surface.ts'
+
+/** Injected business face of one assistant-message quote action entry. */
+export interface QuoteActionInjected {
+  hooks: {
+    /** The owning Session's quote dialog state, shared by both entries. */
+    dialog: HostObservable<QuoteDialogState>
+  }
+  /** Open the Session's quote dialog for one resolved target. */
+  open: (target: QuoteTarget) => void
+}
+
+/** Full props of the assistant-message quote action entry. */
+export type QuoteActionProps =
+  PropsRuntime<'conversation.chat.assistant-actions'>
+  & InjectFace<QuoteActionInjected>
+  & PropsLocale<'quote'>
+
+/** Injected business face of the Session's quote dialog entry. */
+export interface QuoteDialogInjected {
+  hooks: {
+    /** The Session's quote dialog state. */
+    dialog: HostObservable<QuoteDialogState>
+  }
+  /** Replace the dialog comment. */
+  setComment: (text: string) => void
+  /** Close the dialog, discarding the comment. */
+  close: () => void
+}
+
+/** Full props of the quote dialog overlay entry. */
+export type QuoteDialogProps =
+  PropsRuntime<'conversation.input.overlay'>
+  & InjectFace<QuoteDialogInjected>
+  & PropsLocale<'quote'>
+
+/**
+ * The paragraph tracker has no dialog hooks of its own — it only resolves
+ * a hovered paragraph and opens the Session's shared dialog.
+ */
+export interface ParagraphTrackerInjected {
+  /** Open the Session's quote dialog for one resolved target. */
+  open: (target: QuoteTarget) => void
+}
+
+/** Full props of the per-paragraph quote tracker overlay entry. */
+export type ParagraphTrackerProps =
+  PropsRuntime<'conversation.input.overlay'>
+  & InjectFace<ParagraphTrackerInjected>
+  & PropsLocale<'quote'>
