@@ -0,0 +1,56 @@
+/**
+ * One Session's quote surface: the dialog state shared by the assistant
+ * message action entry (which opens it) and the composer overlay entry
+ * (which renders it and composes the submission).
+ * @module @deepseek-ai/dsh-client-ui-quote/client/surface
+ */
+
+import { createSnapshotStore, type SnapshotStore } from '@deepseek-ai/dsh-client-store'
+import { type QuoteTarget } from './quote.ts'
+
+/** The dialog's published state for one Session. */
+export interface QuoteDialogState {
+  /** Whether the dialog is showing. */
+  readonly open: boolean
+  /** The quote target the dialog is open for; null when closed. */
+  readonly target: QuoteTarget | null
+  /** The comment the human is typing in the dialog. */
+  readonly comment: string
+}
+
+/** Closed resting state. */
+export const QUOTE_CLOSED: QuoteDialogState = Object.freeze({ open: false, target: null, comment: '' })
+
+/** The per-session surface behind both quote entries of one Session. */
+export class QuoteSurface {
+  /** The dialog state, shared by the action entry and the overlay entry. */
+  readonly state: SnapshotStore<QuoteDialogState> = createSnapshotStore<QuoteDialogState>(QUOTE_CLOSED)
+
+  /**
+   * Open the dialog for one resolved target, replacing any open target.
+   * @param target - the resolved quote target.
+   */
+  open(target: QuoteTarget): void {
+    this.state.set({ open: true, target, comment: '' })
+  }
+
+  /** Close the dialog, discarding the in-flight comment. */
+  close(): void {
+    this.state.set(QUOTE_CLOSED)
+  }
+
+  /**
+   * Replace the dialog comment.
+   * @param text - the current comment text.
+   */
+  setComment(text: string): void {
+    const current = this.state.getSnapshot()
+    if (current.comment === text) return
+    this.state.set({ ...current, comment: text })
+  }
+
+  /** Retire the surface: close the dialog so no stale state outlives the fiber. */
+  dispose(): void {
+    this.state.set(QUOTE_CLOSED)
+  }
+}
