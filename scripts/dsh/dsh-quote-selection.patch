+/* The per-paragraph margin box, fixed-positioned beside the hovered
+   paragraph. One size with the strip actions, lighter treatment because
+   it floats in the reading margin. */
+.box {
+  position: fixed;
+  z-index: 60;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
