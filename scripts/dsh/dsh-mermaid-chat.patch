@@ -0,0 +1,78 @@
+/**
+ * Mermaid fence renderer: a settled ```mermaid fence becomes a diagram.
+ * The fence's CodeBlock is the default presentation — the diagram replaces
+ * it only once rendered, and a parse failure leaves the code block in place
+ * permanently, so the fallback needs no new chrome strings (the fence's
+ * localized copy already exists). Streaming fences never reach this
+ * component: like TeX, a half-typed diagram stays literal code until the
+ * block settles.
+ *
+ * The mermaid engine is dynamically imported on first use, so it never
+ * enters the initial bundle. `securityLevel: 'strict'` keeps untrusted
+ * diagram sources sanitized (labels escaped, click handlers and scripts
+ * disabled), and the returned SVG is mapped through the shared
+ * DOMParser→React path (dom-to-react.ts) — no HTML string enters the DOM.
+ *
+ * Mermaid bakes colors at render time, so the theme is resolved from the
+ * document's theme-source attribute (set by ui-theme's boot script) with a
+ * `prefers-color-scheme` fallback for `system`; a theme change re-renders
+ * diagrams on their next mount, not live.
+ */
+
+import { useEffect, useState } from 'react'
+import type { ReactNode } from 'react'
+import { domToReact } from './dom-to-react.ts'
+import css from './MermaidBlock.module.css'
+
+let renderSeq = 0
+let initializedTheme: string | null = null
+
+/** Resolve the mermaid theme name from the document's theme signals. */
+function diagramTheme(): 'dark' | 'default' {
+  const preference = document.documentElement.dataset['dsThemeSource']
+  if (preference === 'dark') return 'dark'
+  if (preference === 'light') return 'default'
+  // Same absent-media-query guard ui-theme uses: environments without
+  // matchMedia resolve to the light theme.
+  return typeof window.matchMedia === 'function'
+    && window.matchMedia('(prefers-color-scheme: dark)').matches
+    ? 'dark' : 'default'
+}
+
+/** Render one diagram source to its SVG string; rejects on parse errors. */
+async function renderDiagram(code: string): Promise<string> {
+  const { default: mermaid } = await import('mermaid')
+  const theme = diagramTheme()
+  if (initializedTheme !== theme) {
+    initializedTheme = theme
+    mermaid.initialize({ startOnLoad: false, securityLevel: 'strict', theme })
+  }
+  const { svg } = await mermaid.render(`dsh-mermaid-${++renderSeq}`, code)
+  return svg
+}
+
+/**
+ * Render one settled mermaid fence, falling back to its code block until
+ * (and unless) a diagram materializes.
+ * @param code - The fence source.
+ * @param fallback - The fence's CodeBlock element, shown while pending and
+ * forever when the source does not parse.
+ */
+export function MermaidBlock({ code, fallback }: { code: string; fallback: ReactNode }): ReactNode {
+  const [svg, setSvg] = useState<string | null>(null)
+  useEffect(() => {
+    let alive = true
+    renderDiagram(code).then(
+      (value) => { if (alive) setSvg(value) },
+      () => { /* parse failure: the fallback code block stays */ },
+    )
+    return () => { alive = false }
+  }, [code])
+  if (svg === null) return fallback
+  const parsed = new DOMParser().parseFromString(svg, 'text/html')
+  return (
+    <div className={css.root} data-mermaid-diagram>
+      {[...parsed.body.childNodes].map((node, index) => domToReact(node, index))}
+    </div>
+  )
+}
