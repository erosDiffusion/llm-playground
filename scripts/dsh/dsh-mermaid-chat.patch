diff --git a/packages/client/ui-primitives/tests/mermaid.client.spec.tsx b/packages/client/ui-primitives/tests/mermaid.client.spec.tsx
new file mode 100644
index 0000000000..d291964b15
--- /dev/null
+++ b/packages/client/ui-primitives/tests/mermaid.client.spec.tsx
@@ -0,0 +1,99 @@
+// @vitest-environment jsdom
+import { cleanup, render, waitFor } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import type { Mock } from 'vitest'
+import { MarkdownText } from './markdown-test-components.tsx'
+
+// jsdom has no SVG layout engine (getBBox), so mermaid cannot render there —
+// the engine is mocked at this tier; real diagram rendering is verified in
+// the browser lane. The mock keeps the component's contract honest:
+// initialize-on-theme-change, render-per-fence, and parse-failure rejection.
+vi.mock('mermaid', () => {
+  const initialize = vi.fn()
+  const render = vi.fn(async (_id: string, code: string) => {
+    if (code.includes('%%%')) throw new Error('Parse error')
+    return { svg: '<svg viewBox="0 0 10 10"><g class="root"><rect width="9" height="9"/><text>hi</text></g></svg>' }
+  })
+  return { default: { initialize, render } }
+})
+
+import mermaid from 'mermaid'
+const engine = mermaid as unknown as { initialize: Mock; render: Mock }
+
+const VALID = '```mermaid\nflowchart LR\n  A[Start] --> B[Done]\n```'
+
+afterEach(() => {
+  cleanup()
+  delete document.documentElement.dataset['dsThemeSource']
+  delete (window as { matchMedia?: unknown }).matchMedia
+  vi.restoreAllMocks()
+})
+
+beforeEach(() => {
+  engine.render.mockClear()
+})
+
+describe('mermaid fences', () => {
+  it('replaces a settled fence with a rendered diagram', async () => {
+    const { container } = render(<MarkdownText text={VALID} />)
+    // The code block is the pending view until the diagram materializes.
+    expect(container.querySelector('pre code')).not.toBeNull()
+    expect(container.querySelector('[data-mermaid-diagram]')).toBeNull()
+    await waitFor(() => { expect(container.querySelector('[data-mermaid-diagram] svg')).not.toBeNull() })
+    expect(container.querySelector('pre')).toBeNull()
+  })
+
+  it('keeps a streaming fence as literal code', () => {
+    const { container } = render(<MarkdownText streaming text={VALID} />)
+    expect(container.querySelector('[data-mermaid-diagram]')).toBeNull()
+    expect(container.querySelector('pre code')?.textContent).toContain('flowchart LR')
+    expect(engine.render).not.toHaveBeenCalled()
+  })
+
+  it('leaves the code block in place when the source does not parse', async () => {
+    const { container } = render(<MarkdownText text={'```mermaid\nnot a diagram %%%\n```'} />)
+    await waitFor(() => { expect(engine.render).toHaveBeenCalled() })
+    await new Promise(resolve => setTimeout(resolve, 50))
+    expect(container.querySelector('[data-mermaid-diagram]')).toBeNull()
+    expect(container.querySelector('pre code')?.textContent).toContain('not a diagram')
+  })
+
+  it('ignores a late diagram after the fence unmounted', async () => {
+    const { container, unmount } = render(<MarkdownText text={VALID} />)
+    unmount()
+    await new Promise(resolve => setTimeout(resolve, 50))
+    expect(container.querySelector('[data-mermaid-diagram]')).toBeNull()
+  })
+
+  it('resolves the theme from the document signals and re-initializes on change', async () => {
+    // No explicit source, jsdom matchMedia reports light: 'default'.
+    const first = render(<MarkdownText text={VALID} />)
+    await waitFor(() => { expect(first.container.querySelector('[data-mermaid-diagram] svg')).not.toBeNull() })
+    expect(engine.initialize.mock.calls.at(-1)?.[0]).toMatchObject({ securityLevel: 'strict', theme: 'default' })
+
+    // Explicit dark re-initializes; a second dark render does not.
+    document.documentElement.dataset['dsThemeSource'] = 'dark'
+    const second = render(<MarkdownText text={VALID} />)
+    await waitFor(() => { expect(second.container.querySelector('[data-mermaid-diagram] svg')).not.toBeNull() })
+    expect(engine.initialize.mock.calls.at(-1)?.[0]).toMatchObject({ theme: 'dark' })
+    const afterDark = engine.initialize.mock.calls.length
+    const third = render(<MarkdownText text={VALID} />)
+    await waitFor(() => { expect(third.container.querySelector('[data-mermaid-diagram] svg')).not.toBeNull() })
+    expect(engine.initialize.mock.calls).toHaveLength(afterDark)
+
+    // Explicit light, then system-dark via matchMedia.
+    document.documentElement.dataset['dsThemeSource'] = 'light'
+    const fourth = render(<MarkdownText text={VALID} />)
+    await waitFor(() => { expect(fourth.container.querySelector('[data-mermaid-diagram] svg')).not.toBeNull() })
+    expect(engine.initialize.mock.calls.at(-1)?.[0]).toMatchObject({ theme: 'default' })
+    delete document.documentElement.dataset['dsThemeSource']
+    // This jsdom has no matchMedia; define it to exercise the system branch.
+    window.matchMedia = ((query: string) => ({
+      matches: query.includes('dark'), media: query, addListener() {}, removeListener() {},
+      addEventListener() {}, removeEventListener() {}, onchange: null,
+    })) as unknown as typeof window.matchMedia
+    const fifth = render(<MarkdownText text={VALID} />)
+    await waitFor(() => { expect(fifth.container.querySelector('[data-mermaid-diagram] svg')).not.toBeNull() })
+    expect(engine.initialize.mock.calls.at(-1)?.[0]).toMatchObject({ theme: 'dark' })
+  })
+})
