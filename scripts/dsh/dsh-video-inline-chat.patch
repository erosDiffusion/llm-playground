 function renderImage(url: string, alt: string, key: Key, context: MarkdownRenderContext): ReactNode {
+  const sanitized = sanitizeUrl(normalizeUri(url))
+  const videoSrc = remoteVideoUrl(sanitized)
+  if (videoSrc !== undefined) {
+    // React's VideoHTMLAttributes omit the global referrerpolicy attribute; the
+    // protocol allowlist + absolute-HTTP(S) check above are the real gate, so
+    // the player is rendered without it rather than widening the element type.
+    return (
+      <video
+        key={key}
+        className={css.image}
+        src={videoSrc}
+        controls
+        preload="metadata"
+      />
+    )
+  }
   return <MarkdownImage key={`${key}:${url}`} destination={url} alt={alt}
     pathImages={context.pathImages} streaming={context.streaming} inLink={context.inLink === true} />
 }
