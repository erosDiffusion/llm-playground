+    const markdown = [
+      '![orbit](http://127.0.0.1:8765/cube-orbit.mp4)',
+      '![stream](https://example.com/clip.WEBM?token=abc)',
+      '![still](https://example.com/photo.png)',
+    ].join('\n\n')
+    const { container } = render(<MarkdownText text={markdown} />)
+    const videos = [...container.querySelectorAll('video')]
+    expect(videos.map(video => video.getAttribute('src'))).toEqual([
+      'http://127.0.0.1:8765/cube-orbit.mp4',
+      'https://example.com/clip.WEBM?token=abc',
+    ])
+    for (const video of videos) {
+      expect(video.getAttribute('controls')).toBe('')
+      expect(video.getAttribute('preload')).toBe('metadata')
