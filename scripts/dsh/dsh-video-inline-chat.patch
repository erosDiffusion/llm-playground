+/** Path extensions that render an image-syntax destination as a <video> player instead of an <img>. */
+const VIDEO_EXTENSIONS = new Set(['.mp4', '.webm', '.ogv'])
+
+function remoteVideoUrl(url: string): string | undefined {
+  try {
+    const parsed = new URL(url)
+    if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') return undefined
+    const dot = parsed.pathname.lastIndexOf('.')
+    if (dot === -1) return undefined
+    return VIDEO_EXTENSIONS.has(parsed.pathname.slice(dot).toLowerCase()) ? url : undefined
+  } catch {
+    // Same single failure mode as above: not an absolute URL.
+    return undefined
+  }
+}
