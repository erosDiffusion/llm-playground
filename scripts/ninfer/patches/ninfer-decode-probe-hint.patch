+// sharp/libvips q85 JPEG whose entropy data scores well enough against the mpegts demuxer
+// probe that, with no filename to anchor demuxer selection, avformat_open_input() selects
+// mpegts and exposes no stream at all — decode_image() then threw "media has no decodable
+// video stream" for a perfectly valid image. The decoder must anchor the probe with the
+// container magic (see probe_filename_hint in decode.cpp). 914x734, 142524 bytes.
+void test_mpegts_misprobe_jpeg() {
+    const std::string path =
+        std::string(NINFER_SOURCE_DIR) + "/tests/fixtures/media/sharp_jpeg_mpegts_misprobe.jpg";
+    std::ifstream stream(path, std::ios::binary);
+    if (!stream) { throw std::runtime_error("failed to open media decode fixture: " + path); }
+    std::vector<std::uint8_t> encoded{
+        std::istreambuf_iterator<char>(stream), std::istreambuf_iterator<char>()};
+
+    const ninfer::media::decode::ImageInfo info = ninfer::media::decode::inspect_image(encoded, {});
+    const ninfer::media::decode::Image image    = ninfer::media::decode::decode_image(encoded, {});
+    if (info.width != image.width || info.height != image.height || image.width != 914 ||
+        image.height != 734 || image.rgb.size() != 914U * 734U * 3U) {
+        throw std::runtime_error("decoded misprobe JPEG dimensions mismatch");
+    }
+    bool any_nonblack = false;
+    for (std::uint8_t byte : image.rgb) { if (byte != 0) { any_nonblack = true; break; } }
+    if (!any_nonblack) { throw std::runtime_error("decoded misprobe JPEG is all black"); }
+}
+
 } // namespace
 
