+// avformat_open_input() with a null filename can only probe the raw bytes. The byte
+// patterns of some encoder outputs match the mpegts demuxer's probe score well enough
+// that the probe selects mpegts, exposes no stream at all, and a perfectly decodable
+// image is rejected with "media has no decodable video stream" (the same bytes open
+// fine when given a filename with a matching extension). Anchor the probe with a
+// synthetic filename whose extension matches the container magic so FFmpeg's
+// extension-based demuxer preference applies. Unknown magic yields no hint and the
+// probe behaves exactly as before.
+std::string probe_filename_hint(std::span<const std::uint8_t> bytes) {
+    const auto starts_with = [](std::span<const std::uint8_t> data, std::string_view signature) {
+        return data.size() >= signature.size() &&
+               std::equal(signature.begin(), signature.end(), data.begin());
+    };
+    if (starts_with(bytes, "\x89PNG\r\n\x1a\n")) { return "media.png"; }
+    if (bytes.size() >= 3 && bytes[0] == 0xff && bytes[1] == 0xd8 && bytes[2] == 0xff) {
+        return "media.jpg";
+    }
+    if (bytes.size() >= 12 && starts_with(bytes, "RIFF") &&
+        std::equal(std::string_view("WEBP").begin(), std::string_view("WEBP").end(),
+                   bytes.begin() + 8)) {
+        return "media.webp";
+    }
+    if (starts_with(bytes, "GIF8")) { return "media.gif"; }
+    return {};
+}
